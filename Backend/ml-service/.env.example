# Keep this secret only on the ML server. Never put it in an Expo or dashboard .env file.
ROBOFLOW_API_KEY=
# Format: your-project-slug/version, for example civic-road-issues/3
ROBOFLOW_MODEL_ID=

# Temporary SIH demo fallback. It uses the driver's selected issue and is clearly labelled as demo mode.
DEMO_ML_MODE=false
